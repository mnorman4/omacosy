{
  "$schema": "vscode://schemas/color-theme",
  "name": "Omacosy: Lupine",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#212121",
    "descriptionForeground": "#424242",
    "disabledForeground": "#757575A0",
    "focusBorder": "#3264eb",
    "contrastBorder": "#9e9e9e",
    "selection.background": "#d0d0d0",
    "textLink.foreground": "#3264eb",
    "textLink.activeForeground": "#9f85e0",
    "textBlockQuote.background": "#ececec",
    "textBlockQuote.border": "#3264eb",
    "textCodeBlock.background": "#dedede",
    "button.background": "#3264eb",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#9f85e0",
    "button.secondaryBackground": "#9e9e9e",
    "button.secondaryForeground": "#000000",
    "button.secondaryHoverBackground": "#f5f5f5",
    "badge.background": "#3264eb",
    "badge.foreground": "#ffffff",
    "input.background": "#ececec",
    "input.foreground": "#212121",
    "input.border": "#9e9e9e",
    "input.placeholderForeground": "#757575",
    "dropdown.background": "#ececec",
    "dropdown.foreground": "#212121",
    "dropdown.border": "#9e9e9e",
    "list.activeSelectionBackground": "#d0d0d0",
    "list.activeSelectionForeground": "#000000",
    "list.inactiveSelectionBackground": "#d0d0d0A0",
    "list.inactiveSelectionForeground": "#212121",
    "list.hoverBackground": "#f5f5f5",
    "list.focusOutline": "#3264eb",
    "activityBar.background": "#dedede",
    "activityBar.foreground": "#3264eb",
    "activityBar.inactiveForeground": "#757575",
    "activityBar.border": "#9e9e9e",
    "activityBarBadge.background": "#3264eb",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#ececec",
    "sideBar.foreground": "#424242",
    "sideBar.border": "#9e9e9e",
    "sideBarTitle.foreground": "#000000",
    "sideBarSectionHeader.background": "#f5f5f5",
    "sideBarSectionHeader.foreground": "#3264eb",
    "editorGroupHeader.tabsBackground": "#dedede",
    "editorGroup.border": "#9e9e9e",
    "tab.activeBackground": "#fafafa",
    "tab.activeForeground": "#000000",
    "tab.activeBorderTop": "#3264eb",
    "tab.inactiveBackground": "#ececec",
    "tab.inactiveForeground": "#757575",
    "tab.border": "#9e9e9e",
    "titleBar.activeBackground": "#dedede",
    "titleBar.activeForeground": "#000000",
    "titleBar.inactiveBackground": "#dedede",
    "titleBar.inactiveForeground": "#757575",
    "titleBar.border": "#9e9e9e",
    "statusBar.background": "#dedede",
    "statusBar.foreground": "#424242",
    "statusBar.border": "#9e9e9e",
    "statusBar.debuggingBackground": "#9e9e9e",
    "statusBar.noFolderBackground": "#dedede",
    "panel.background": "#ececec",
    "panel.border": "#9e9e9e",
    "panelTitle.activeForeground": "#3264eb",
    "panelTitle.inactiveForeground": "#757575",
    "panelTitle.activeBorder": "#3264eb",
    "editor.background": "#fafafa",
    "editor.foreground": "#212121",
    "editorCursor.foreground": "#3264eb",
    "editor.selectionBackground": "#d0d0d0",
    "editor.selectionForeground": "#000000",
    "editor.inactiveSelectionBackground": "#d0d0d080",
    "editor.selectionHighlightBackground": "#9e9e9e70",
    "editor.wordHighlightBackground": "#3264eb35",
    "editor.wordHighlightStrongBackground": "#0c67de35",
    "editor.lineHighlightBackground": "#f5f5f580",
    "editorLineNumber.foreground": "#757575",
    "editorLineNumber.activeForeground": "#3264eb",
    "editorWhitespace.foreground": "#9e9e9e",
    "editorIndentGuide.background1": "#9e9e9e70",
    "editorIndentGuide.activeBackground1": "#3264ebA0",
    "editorBracketMatch.background": "#d0d0d0",
    "editorBracketMatch.border": "#3264eb",
    "editor.findMatchBackground": "#3264eb45",
    "editor.findMatchBorder": "#3264eb",
    "editor.findMatchHighlightBackground": "#0c67de30",
    "editorGutter.background": "#fafafa",
    "editorWidget.background": "#ececec",
    "editorWidget.foreground": "#212121",
    "editorWidget.border": "#9e9e9e",
    "editorHoverWidget.background": "#ececec",
    "editorHoverWidget.foreground": "#212121",
    "editorHoverWidget.border": "#9e9e9e",
    "peekView.border": "#3264eb",
    "peekViewEditor.background": "#ececec",
    "peekViewResult.background": "#dedede",
    "peekViewTitle.background": "#f5f5f5",
    "terminal.background": "#fafafa",
    "terminal.foreground": "#212121",
    "terminalCursor.foreground": "#3264eb",
    "terminal.selectionBackground": "#d0d0d0",
    "terminal.ansiBlack": "#dedede",
    "terminal.ansiRed": "#c900c4",
    "terminal.ansiGreen": "#4a2fd0",
    "terminal.ansiYellow": "#026fde",
    "terminal.ansiBlue": "#3264eb",
    "terminal.ansiMagenta": "#8a4ad7",
    "terminal.ansiCyan": "#0c67de",
    "terminal.ansiWhite": "#424242",
    "terminal.ansiBrightBlack": "#757575",
    "terminal.ansiBrightRed": "#f930fb",
    "terminal.ansiBrightGreen": "#9f85e0",
    "terminal.ansiBrightYellow": "#358fff",
    "terminal.ansiBrightBlue": "#5482ff",
    "terminal.ansiBrightMagenta": "#b363ff",
    "terminal.ansiBrightCyan": "#3986ff",
    "terminal.ansiBrightWhite": "#000000",
    "gitDecoration.addedResourceForeground": "#4a2fd0",
    "gitDecoration.modifiedResourceForeground": "#0c67de",
    "gitDecoration.deletedResourceForeground": "#c900c4",
    "gitDecoration.untrackedResourceForeground": "#9f85e0",
    "gitDecoration.ignoredResourceForeground": "#757575"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#757575",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#4a2fd0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#358fff"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#9f85e0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#0c67de"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#8a4ad7"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#212121"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.function-call.arguments"
      ],
      "settings": {
        "foreground": "#424242"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#3264eb"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#3986ff"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#3264eb"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#3264eb",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#424242",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#3986ff"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f930fb",
        "fontStyle": "bold underline"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#757575",
      "italic": true
    },
    "string": "#4a2fd0",
    "number": "#358fff",
    "keyword": {
      "foreground": "#9f85e0",
      "bold": true
    },
    "function": "#0c67de",
    "method": "#0c67de",
    "type": "#8a4ad7",
    "class": "#8a4ad7",
    "property": "#3986ff",
    "variable.readonly": "#358fff",
    "parameter": "#424242"
  }
}
